#!/bin/sh
# Trava para impedir commits diretos nas branches principais (main / master)

current_branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
    if [ "$ALLOW_PROTECTED_COMMIT" = "1" ]; then
        exit 0
    fi

    echo ""
    echo "========================================================================"
    echo " [BLOQUEIO GIT] Commits diretos na branch '$current_branch' não são permitidos!"
    echo "========================================================================"
    echo " O agente e desenvolvedores devem sempre atuar em uma branch separada."
    echo " Por favor, crie uma feature branch e abra um Pull Request:"
    echo ""
    echo "   git checkout -b feature/sua-feature"
    echo "   git commit ..."
    echo "   git push -u origin feature/sua-feature"
    echo "   gh pr create"
    echo ""
    echo " (Caso seja estritamente necessário commitar na '$current_branch', use:"
    echo "  ALLOW_PROTECTED_COMMIT=1 git commit ... ou git commit --no-verify)"
    echo "========================================================================"
    echo ""
    exit 1
fi

exit 0
