<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="PackagingTests.fs" />
    <Compile Include="LspTransportTests.fs" />
    <Compile Include="LspClientTests.fs" />
    <Compile Include="FsacProcessTests.fs" />
    <Compile Include="PrologueTests.fs" />
    <Compile Include="FsacBridgeUriTests.fs" />
    <Compile Include="FsacBridgeCheckTests.fs" />
    <Compile Include="FsacBridgeHoverTests.fs" />
    <Compile Include="FsacBridgeDefinitionTests.fs" />
    <Compile Include="FsacBridgeSignatureHelpTests.fs" />
    <Compile Include="FsacBridgeCompletionTests.fs" />
    <Compile Include="FsacBridgeRenameTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FSharpQueryStudio.Fsac\FSharpQueryStudio.Fsac.fsproj" />
    <ProjectReference Include="..\..\src\FSharpQueryStudio.Connectors\FSharpQueryStudio.Connectors.fsproj" />
    <ProjectReference Include="..\..\src\FSharpQueryStudio.Results\FSharpQueryStudio.Results.fsproj" />
  </ItemGroup>

</Project>
