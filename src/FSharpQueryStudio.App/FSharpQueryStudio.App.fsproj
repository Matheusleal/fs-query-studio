<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Transitively pulls FSharp.Compiler.Service via Worker -> Execution;
         see the matching note in FSharpQueryStudio.Execution.fsproj. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="WorkerClient.fs" />
    <Compile Include="ExecutionService.fs" />
    <Compile Include="AnalysisService.fs" />
    <Compile Include="ConnectionService.fs" />
    <Compile Include="ExportService.fs" />
    <Compile Include="App.axaml.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharpQueryStudio.Logging\FSharpQueryStudio.Logging.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Worker\FSharpQueryStudio.Worker.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Protocol\FSharpQueryStudio.Protocol.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Storage\FSharpQueryStudio.Storage.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Ui\FSharpQueryStudio.Ui.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Results\FSharpQueryStudio.Results.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Security\FSharpQueryStudio.Security.fsproj" />
  </ItemGroup>

</Project>
