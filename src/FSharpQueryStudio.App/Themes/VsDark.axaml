<!-- src/FSharpQueryStudio.App/Themes/VsDark.axaml -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowBackgroundColor">#1A1B23</Color>
  <Color x:Key="PanelBackgroundColor">#1E1F29</Color>
  <Color x:Key="ChromeBackgroundColor">#24252F</Color>
  <Color x:Key="HoverBackgroundColor">#2E303D</Color>
  <Color x:Key="SelectionBackgroundColor">#332C5C</Color>
  <Color x:Key="AccentColor">#6C5CE7</Color>
  <Color x:Key="AccentHoverColor">#8477F0</Color>
  <Color x:Key="AccentMutedColor">#3D6C5CE7</Color>

  <!--
    FluentTheme's own built-in controls (ComboBox focus, CheckBox,
    RadioButton, Slider, selection pipes, etc.) derive their accent
    visuals from these six SystemAccentColor* resources rather than a
    per-control DynamicResource — overriding them here reskins that
    "free" FluentTheme chrome to the indigo accent without needing to
    know each control's internal template part names.
  -->
  <Color x:Key="SystemAccentColor">#6C5CE7</Color>
  <Color x:Key="SystemAccentColorLight1">#8274EB</Color>
  <Color x:Key="SystemAccentColorLight2">#988DEE</Color>
  <Color x:Key="SystemAccentColorLight3">#AEA5F2</Color>
  <Color x:Key="SystemAccentColorDark1">#5C4EC4</Color>
  <Color x:Key="SystemAccentColorDark2">#4C40A2</Color>
  <Color x:Key="SystemAccentColorDark3">#3B337F</Color>
  <Color x:Key="PrimaryTextColor">#E4E4EA</Color>
  <Color x:Key="SecondaryTextColor">#9A9AA8</Color>
  <Color x:Key="BorderColor">#33343F</Color>
  <Color x:Key="ErrorTextColor">#E06C75</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
  <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="{StaticResource ChromeBackgroundColor}" />
  <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}" />
  <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorTextColor}" />
</ResourceDictionary>
