<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssetHost.fs" />
    <Compile Include="EditorBridge.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored Monaco (bundled locally per Section 6) + the bridge
         page. Content + CopyToOutputDirectory so it also lands next to
         the App executable that actually serves it via AssetHost. -->
    <Content Include="EditorAssets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- `AssetHost` logs its real bound port on start and any unexpected
         accept-loop failure, matching the `Log.Information`/`Log.Warning`
         convention already used directly (not via `ILogger<T>`) in
         `Worker`/`Ui`/`App`. Same 4.4.0 pin as every other project here. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharpQueryStudio.Protocol\FSharpQueryStudio.Protocol.fsproj" />
  </ItemGroup>

</Project>
