<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="IConnector.fs" />
    <Compile Include="SqliteConnector.fs" />
    <Compile Include="SqlServerConnector.fs" />
    <Compile Include="PostgreSqlConnector.fs" />
    <Compile Include="CsvConnector.fs" />
    <Compile Include="ExcelConnector.fs" />
    <Compile Include="RestConnector.fs" />
    <Compile Include="Connections.fs" />
    <Compile Include="WorkspaceConnectionResolver.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Pin past the transitive 2.1.11 default, which NU1903 flags for
         GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharpQueryStudio.Protocol\FSharpQueryStudio.Protocol.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Security\FSharpQueryStudio.Security.fsproj" />
  </ItemGroup>

</Project>
