<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FSharpQueryStudio.Connectors.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>FSharpQueryStudio.Worker</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="SqlDialect.fs" />
    <Compile Include="SqlPushdownPlan.fs" />
    <Compile Include="RecordReaders.fs" />
    <Compile Include="ExpressionPushdownTranslator.fs" />
    <Compile Include="SqlPushdownQuery.fs" />
    <Compile Include="SqlComputationExtensions.fs" />
    <Compile Include="FileSqliteEngine.fs" />
    <Compile Include="AdvancedSampleInitScripts.fs" />
    <Compile Include="AdvancedSampleNotebookCommon.fs" />
    <Compile Include="AdvancedSampleNotebooksPostgres.fs" />
    <Compile Include="AdvancedSampleNotebooksSqlServer.fs" />
    <Compile Include="AdvancedSampleNotebooksEngines.fs" />
    <Compile Include="AdvancedSampleGenerator.fs" />
    <Compile Include="DatabaseEntityGenerator.fs" />
    <Compile Include="Connections.fs" />
    <Compile Include="ConnectionExtensions.fs" />
    <Compile Include="ModularEntityGenerators.fs" />
    <Compile Include="BuiltinConnectors.fs" />
    <Compile Include="WorkspaceConnectionResolver.fs" />
    <Compile Include="EntityBackgroundGenerator.fs" />
    <Compile Include="SampleDemoNotebookEn.fs" />
    <Compile Include="SampleDemoNotebookPt.fs" />
    <Compile Include="SampleDataSqlite.fs" />
    <Compile Include="SampleDataFiles.fs" />
    <Compile Include="SampleDataGenerator.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="SQLProvider" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgSQLProvider)\typeproviders\fsharp41\net10.0\FSharp.Data.SqlProvider.DesignTime.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false"
          Condition="Exists('$(PkgSQLProvider)\typeproviders\fsharp41\net10.0\FSharp.Data.SqlProvider.DesignTime.dll')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Abstractions\FSharpQueryStudio.Connectors.Abstractions.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Sqlite\FSharpQueryStudio.Connectors.Sqlite.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.SqlServer\FSharpQueryStudio.Connectors.SqlServer.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.PostgreSql\FSharpQueryStudio.Connectors.PostgreSql.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.MySql\FSharpQueryStudio.Connectors.MySql.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.MariaDb\FSharpQueryStudio.Connectors.MariaDb.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Oracle\FSharpQueryStudio.Connectors.Oracle.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Csv\FSharpQueryStudio.Connectors.Csv.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Excel\FSharpQueryStudio.Connectors.Excel.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Json\FSharpQueryStudio.Connectors.Json.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Xml\FSharpQueryStudio.Connectors.Xml.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Rest\FSharpQueryStudio.Connectors.Rest.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Protocol\FSharpQueryStudio.Protocol.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Security\FSharpQueryStudio.Security.fsproj" />
  </ItemGroup>

</Project>
