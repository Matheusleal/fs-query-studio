<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SqlPushdownQuery.fs" />
    <Compile Include="Connections.fs" />
    <Compile Include="ModularEntityGenerators.fs" />
    <Compile Include="WorkspaceConnectionResolver.fs" />
    <Compile Include="EntityBackgroundGenerator.fs" />
    <Compile Include="SampleDataGenerator.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="SQLProvider" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgSQLProvider)\typeproviders\fsharp41\net10.0\FSharp.Data.SqlProvider.DesignTime.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false"
          Condition="Exists('$(PkgSQLProvider)\typeproviders\fsharp41\net10.0\FSharp.Data.SqlProvider.DesignTime.dll')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Abstractions\FSharpQueryStudio.Connectors.Abstractions.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Sqlite\FSharpQueryStudio.Connectors.Sqlite.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.SqlServer\FSharpQueryStudio.Connectors.SqlServer.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.PostgreSql\FSharpQueryStudio.Connectors.PostgreSql.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Csv\FSharpQueryStudio.Connectors.Csv.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Excel\FSharpQueryStudio.Connectors.Excel.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Connectors.Rest\FSharpQueryStudio.Connectors.Rest.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Protocol\FSharpQueryStudio.Protocol.fsproj" />
    <ProjectReference Include="..\FSharpQueryStudio.Security\FSharpQueryStudio.Security.fsproj" />
  </ItemGroup>

</Project>
