<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FSharpQueryStudio.Ui.MainWindow"
        x:CompileBindings="False"
        Title="F# Query Studio"
        Width="1200"
        Height="800">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File" />
      <MenuItem Header="_Edit" />
      <MenuItem Header="_View" />
      <MenuItem Header="_Connections" />
      <MenuItem Header="_Run" />
    </Menu>

    <!--
      Fixed Grid, not a docking framework — see Section 5: workspace pane,
      script tabs + editor, results/output/problems/schema, with
      GridSplitters for the MVP's persisted-splitter-position layout.
    -->
    <Grid ColumnDefinitions="250,4,*" RowDefinitions="*">
      <Border Grid.Column="0" Grid.Row="0" BorderThickness="0,0,1,0" Name="WorkspacePane">
        <TextBlock Text="Workspace" Margin="8" />
      </Border>

      <GridSplitter Grid.Column="1" Grid.Row="0" Width="4" ResizeDirection="Columns" />

      <Grid Grid.Column="2" Grid.Row="0" RowDefinitions="Auto,Auto,*,4,200">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
          <Button Name="RunButton" Content="Run (F5)" Margin="0,0,4,0" />
          <Button Name="CancelButton" Content="Cancel" Margin="0,0,8,0" />
          <Button Name="CopyResultButton" Content="Copy Result" Margin="0,0,8,0" />
          <Button Name="ResetSessionButton" Content="Reset Session" Margin="0,0,8,0" />
          <TextBlock Text="{Binding WorkerState.Current}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="{Binding ActiveDocument.SessionStateDisplay}" VerticalAlignment="Center" />
        </StackPanel>

        <TabControl Grid.Row="1" Name="ScriptTabs" />

        <NativeWebView Grid.Row="2" Name="MonacoWebView" />

        <GridSplitter Grid.Row="3" Height="4" ResizeDirection="Rows" />

        <TabControl Grid.Row="4" Name="ResultsTabs">
          <TabItem Header="Results">
            <Grid>
              <!--
                DisplayText for Scalar/Text/Error; a virtualized DataGrid
                for Table (C.12) - Columns are rebuilt from Result.Schema
                in code-behind (ResultGridColumns.build) since Avalonia's
                DataGrid needs concrete columns, not a schema binding.
                ItemsSource binds Result.Rows (obj array array) directly,
                so the DataGrid virtualizes rows itself for large results.
              -->
              <TextBlock Text="{Binding Result.DisplayText}"
                         IsVisible="{Binding Result.IsScalarOrText}"
                         Margin="8"
                         TextWrapping="Wrap" />
              <DataGrid Name="ResultsGrid"
                        ItemsSource="{Binding Result.Rows}"
                        IsVisible="{Binding Result.IsTable}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True" />
            </Grid>
          </TabItem>
          <TabItem Header="Output">
            <ListBox ItemsSource="{Binding Result.Output}" Name="OutputList">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" FontFamily="Consolas,Cascadia Mono,monospace" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
          <TabItem Header="Problems" />
          <TabItem Header="Schema" />
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
