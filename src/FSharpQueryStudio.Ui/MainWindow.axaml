<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="FSharpQueryStudio.Ui.MainWindow"
        x:CompileBindings="False"
        Title="F# Query Studio"
        Width="1400"
        Height="900"
        Background="{DynamicResource WindowBackgroundBrush}">
  <!--
    Fixed shell layout: Workspace | Editor / Results, with a hand-rolled
    tab strip (`TabStripPanel`, rebuilt in code-behind by `rebuildTabs`).
  -->
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{DynamicResource ChromeBackgroundBrush}">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Name="NewMenuItem" />
        <MenuItem Header="_Open..." Name="OpenMenuItem" />
        <MenuItem Header="_Save" Name="SaveMenuItem" />
        <MenuItem Header="Save _As..." Name="SaveAsMenuItem" />
        <Separator />
        <MenuItem Header="E_xit" Name="ExitMenuItem" />
      </MenuItem>
      <MenuItem Header="_Edit" IsEnabled="False" />
      <MenuItem Header="_View">
        <MenuItem Header="Toggle _Theme" Name="ToggleThemeMenuItem" />
        <Separator />
        <MenuItem Header="_Workspace" Name="ToggleWorkspaceMenuItem" />
        <MenuItem Header="_Results" Name="ToggleResultsMenuItem" />
      </MenuItem>
      <MenuItem Header="_Connections">
        <MenuItem Header="_New Connection…" Name="NewConnectionMenuItem" />
      </MenuItem>
      <MenuItem Header="_Run">
        <!-- InputGesture only *renders* "F5" beside the item; the binding
             that actually handles the key is added to Window.KeyBindings in
             the code-behind, since these commands are wired as Click
             handlers rather than ICommands. -->
        <MenuItem Header="_Run" Name="RunMenuItem" InputGesture="F5" />
        <MenuItem Header="_Cancel" Name="CancelMenuItem" />
        <MenuItem Header="_Reset Session" Name="ResetSessionMenuItem" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Logs…" Name="LogsMenuItem" />
        <MenuItem Header="_Welcome…" Name="WelcomeMenuItem" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ChromeBackgroundBrush}"
            Padding="6,5"
            BoxShadow="0 1 3 0 #20000000">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Name="NewButton" ToolTip.Tip="New">
          <mi:MaterialIcon Kind="FilePlus" Width="16" Height="16" />
        </Button>
        <Button Name="OpenButton" ToolTip.Tip="Open">
          <mi:MaterialIcon Kind="FolderOpen" Width="16" Height="16" />
        </Button>
        <Button Name="SaveButton" ToolTip.Tip="Save">
          <mi:MaterialIcon Kind="ContentSave" Width="16" Height="16" />
        </Button>
        <Separator Margin="8,0" />
        <Button Name="RunButton" ToolTip.Tip="Run (F5)">
          <mi:MaterialIcon Kind="Play" Width="16" Height="16" />
        </Button>
        <Button Name="CancelButton" ToolTip.Tip="Cancel">
          <mi:MaterialIcon Kind="Stop" Width="16" Height="16" />
        </Button>
        <Button Name="CopyResultButton" ToolTip.Tip="Copy Result">
          <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
        </Button>
        <Button Name="ExportCsvButton"
                ToolTip.Tip="Export CSV…"
                IsEnabled="{Binding Result.IsTable}">
          <mi:MaterialIcon Kind="FileExport" Width="16" Height="16" />
        </Button>
        <Button Name="ResetSessionButton" ToolTip.Tip="Reset Session">
          <mi:MaterialIcon Kind="Restore" Width="16" Height="16" />
        </Button>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBackgroundBrush}" Padding="8,2">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding WorkerState.Current}" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="{Binding ActiveDocument.SessionStateDisplay}" Foreground="{DynamicResource PrimaryTextBrush}" />
        <!-- Set directly (not bound) by ExportCsvButton's click handler in
             the code-behind — the most recent CSV export outcome, success
             or failure. A static status field, not a full toast/
             notification system: see MainWindow.axaml.fs. -->
        <TextBlock Name="ExportStatusText" Foreground="{DynamicResource PrimaryTextBrush}" />
      </StackPanel>
    </Border>

    <Grid Name="FixedShellGrid" ColumnDefinitions="220,4,*">
      <Border Grid.Column="0"
              Name="WorkspacePanel"
              Background="{DynamicResource ChromeBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock Text="Workspace" DockPanel.Dock="Top" Margin="8,8,8,4" FontWeight="Bold" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding WorkspaceItems}" Name="WorkspaceItemsControl" HorizontalAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander Margin="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Expanding="ConnectionExpanderExpanded">
                    <Expander.Header>
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Column="0" Text="{Binding Kind}" Opacity="0.7" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                        <Button Grid.Column="2"
                                Padding="4"
                                Click="EditConnectionClicked"
                                ToolTip.Tip="View/edit connection properties">
                          <mi:MaterialIcon Kind="Pencil" Width="14" Height="14" />
                        </Button>
                        <Button Grid.Column="3"
                                Padding="4"
                                Click="RemoveConnectionClicked"
                                ToolTip.Tip="Remove this connection">
                          <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                        </Button>
                      </Grid>
                    </Expander.Header>
                    <StackPanel HorizontalAlignment="Stretch">
                      <TextBlock Text="Loading…" Opacity="0.7" Margin="16,2" IsVisible="{Binding IsLoading}" />
                      <TextBlock Text="{Binding ErrorMessage}"
                                 Foreground="{DynamicResource ErrorTextBrush}"
                                 TextWrapping="Wrap"
                                 Margin="16,2"
                                 IsVisible="{Binding HasError}" />
                      <TextBlock Text="No tables found" Opacity="0.7" Margin="16,2" IsVisible="{Binding HasNoSchema}" />
                      <TextBlock Text="No schema to browse for this connection type"
                                 Opacity="0.7"
                                 Margin="16,2"
                                 IsVisible="{Binding !HasSchema}" />
                      <ItemsControl ItemsSource="{Binding Tables}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Expander Margin="16,2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                              <Expander.Header>
                                <TextBlock Text="{Binding Name}" />
                              </Expander.Header>
                              <ItemsControl ItemsSource="{Binding Columns}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" Margin="16,1" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Expander>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*,4,220">
        <Border Grid.Row="0"
                Name="TabStripBorder"
                Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                BoxShadow="0 1 3 0 #20000000">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Name="TabStripPanel" Orientation="Horizontal" />
          </ScrollViewer>
        </Border>
        <ContentControl Name="EditorHost" Grid.Row="1" />
        <GridSplitter Grid.Row="2" ResizeDirection="Rows" />
        <ContentControl Name="ResultsHost" Grid.Row="3" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
