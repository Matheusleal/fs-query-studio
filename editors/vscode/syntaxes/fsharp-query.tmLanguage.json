{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "F# Query Expression Keywords",
  "scopeName": "fsharp.query.injection",
  "injectionSelector": "L:source.fsharp",
  "patterns": [
    {
      "name": "keyword.control.query.fsharp",
      "match": "\\b(select|where|join|on|equals|into|groupBy|groupValBy|sortBy|sortByDescending|thenBy|thenByDescending|distinct|count|sumBy|minBy|maxBy|averageBy|all|head|nth|exists|contains|take|takeWhile|skip|skipWhile|find)\\b"
    }
  ]
}
