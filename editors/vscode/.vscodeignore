# -----------------------------------------------------------------------------
# F# Query Studio VS Code Extension - Package Exclusions (.vscodeignore)
# -----------------------------------------------------------------------------
# Only runtime distribution bundles, essential manifest files, icon,
# grammars, and legal/documentation files should be packaged in the VSIX.
# Everything else MUST be excluded to prevent leaking secrets, source code,
# debug symbols, or developer environment details.
# -----------------------------------------------------------------------------

# 1. Source Code & Language Files (Never ship raw source code in VSIX)
src/**
**/*.ts
**/*.tsx
**/*.fs
**/*.fsi
**/*.cs
**/*.map
**/*.js.map
**/*.ts.map

# 2. Debug Symbols & Compilations Artifacts
**/*.pdb
out/**

# 3. Tests & Test Configurations
test/**
**/*.test.*
**/*.spec.*
.vscode-test/**
.vscode-test.mjs
vitest.config.ts
vitest.config.mjs
vitest.config.js

# 4. Project, Build & Tooling Scripts
scripts/**
esbuild.mjs
tsconfig.json
tsconfig.integration.json
**/tsconfig*.json
Directory.Build.props
Directory.Build.targets
Directory.Packages.props
**/*.fsproj
**/*.csproj
**/*.sln
**/*.slnx

# 5. Secrets, Credentials & Environment Configs
**/.env*
**/*.env*
**/*.key
**/*.pem
**/*.cert
**/*.crt
**/*.pfx
**/*.p12
**/*secret*
**/*token*
**/*credential*
**/*.publishsettings

# 6. Local Databases, Notebooks, Backups & Logs
**/*.fsqnb
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.dump
**/*.bak
**/*.log
**/*.tmp
**/*.csv

# 7. Package Archives & Node Modules
node_modules/**
*.vsix
**/*.vsix

# 8. Root Extra Documentation & Temporary Copies (source docs live in docs/)
BENCHMARK_REPORT*.md
USER_GUIDE*.md
README_PT.md
CHANGELOG_PT.md

# 9. Version Control, IDE, Agent & System Metadata
.git/**
.gitignore
.gitattributes
.github/**
.githooks/**
.agents/**
.claude/**
.superpowers/**
.vscode/**
.vs/**
.idea/**
.DS_Store
Thumbs.db
